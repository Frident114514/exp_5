# 用户小程序端配置（M05 / M06 / M07）
#
# 复制本文件为 `.env.local`（已被 .gitignore 忽略）后按需修改；
# 不创建时使用 `src/config/env.ts` 中的本机默认值（127.0.0.1:8080）。
# 变量名与 `src/.env.example`（M03 维护）保持一致，改名需先同步该文件。
#
# 注意：微信小程序无法在运行时读取 .env，值是编译期注入的，
# 修改后必须重启 `npm run dev:mp-weixin` 或重新构建。

# 服务端 API 基础地址（含 /api/v1）
VITE_MINIAPP_API_BASE_URL=http://127.0.0.1:8080/api/v1

# 媒体源地址（用于把服务端返回的 /api/v1/media/{id}/content 补全为可访问地址）
VITE_MINIAPP_MEDIA_ORIGIN=http://127.0.0.1:8080

# 是否启用本地模拟接口：true 时命中 api/mock.ts 的样例数据（服务端未就绪时用于调页面）
# 只用于开发；模拟结果不能作为联调完成的证据。演示账号 demo/demo1234、admin/admin1234。
VITE_MINIAPP_USE_MOCK=false
