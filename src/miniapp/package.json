    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5030820261124002",
    "vue": "3.4.21",
    "vue-i18n": "9.14.5"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5030820261124002",
    "@types/node": "22.10.2",
    "typescript": "5.4.5",
    "vite": "5.2.8",
    "vue-tsc": "2.0.29"
  },
  "type": "module"
