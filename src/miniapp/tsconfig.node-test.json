{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".node-test",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "src/api/types.ts",
    "src/api/mockPostApi.ts",
    "src/api/httpPostApi.ts",
    "src/api/runtime.ts",
    "src/utils/postRules.ts",
    "tests-node/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".node-test"]
}
