# ============================================================================
# 多媒体朋友圈展示系统 - 环境变量样例 (src/.env.example)
# 维护成员：M03（潘铭伟）
# 说明：仅包含变量名与示例占位值，严禁向仓库提交真实密码、JWT 密钥或用户隐私数据。
# ============================================================================

# --- 1. 数据库连接配置 (MySQL 8.4 LTS) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=moments_db
DB_URL=jdbc:mysql://127.0.0.1:3306/moments_db?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&useUnicode=true&characterEncoding=utf8
DB_USERNAME=moments_app
DB_PASSWORD=CHANGE_ME_DB_PASSWORD_PLACEHOLDER

# --- 2. 服务端基础与认证配置 (M01) ---
SERVER_PORT=8080
JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_JWT_SECRET_KEY_PLACEHOLDER
JWT_EXPIRE_HOURS=12
ADMIN_INIT_ACCOUNT=admin
ADMIN_INIT_PASSWORD=CHANGE_ME_ADMIN_INIT_PASSWORD_PLACEHOLDER

# --- 3. 媒体文件存储与限制配置 (M03) ---
# 服务端本地媒体存储根目录（数据库仅保存相对 storage_key：yyyy/MM/dd/{uuid}.{ext}）
MEDIA_STORAGE_DIR=./data/media-storage
# 单张图片上限：10 MB (10485760 字节，支持 JPEG / PNG / WebP)
MEDIA_MAX_IMAGE_BYTES=10485760
# 单个 MP4 视频上限：50 MB (52428800 字节，支持 HTTP Range 206 分段播放)
MEDIA_MAX_VIDEO_BYTES=52428800
# 未绑定或编辑解绑后 PENDING 媒体的保留小时数（默认 24 小时后清理）
MEDIA_PENDING_EXPIRE_HOURS=24
# Spring Multipart 请求上限配置
SPRING_MULTIPART_MAX_FILE_SIZE=55MB
SPRING_MULTIPART_MAX_REQUEST_SIZE=60MB

# --- 4. 用户小程序端配置 (M05 / M06 / M07) ---
VITE_MINIAPP_API_BASE_URL=http://127.0.0.1:8080/api/v1
VITE_MINIAPP_MEDIA_ORIGIN=http://127.0.0.1:8080

# --- 5. 管理员 Web 后台配置 (M08) ---
VITE_ADMIN_API_BASE_URL=http://127.0.0.1:8080/api/v1
VITE_ADMIN_DEV_PORT=5173
