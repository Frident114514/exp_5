MOMENTS_DB_URL=jdbc:mysql://127.0.0.1:3306/moments
MOMENTS_DB_USER=moments
MOMENTS_DB_PASSWORD=
MOMENTS_JWT_SECRET=
MOMENTS_DB_POOL_SIZE=20
MOMENTS_DB_MIN_IDLE=5
MOMENTS_DB_WAIT_MS=2000
MOMENTS_HTTP_THREADS=100
MOMENTS_HTTP_QUEUE=100
MOMENTS_HTTP_CONNECTIONS=2048
MOMENTS_HTTP_BACKLOG=100
MOMENTS_AUTH_CONCURRENCY=4
MOMENTS_ME_CONCURRENCY=64
MOMENTS_AUTH_RATE=10
MOMENTS_AUTH_BURST=20
MOMENTS_DIAGNOSTICS_ENABLED=false

# high-concurrency profile: bounded identity waiting
MOMENTS_ME_WAITERS=1024
MOMENTS_ME_WAIT_MS=200

# Optional administrator initialization; supply account and password together.
MOMENTS_ADMIN_ACCOUNT=
MOMENTS_ADMIN_PASSWORD=
MOMENTS_ADMIN_NICKNAME=管理员
