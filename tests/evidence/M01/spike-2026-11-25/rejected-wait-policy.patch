+            long started = System.nanoTime();
+            assertThatThrownBy(() -> gate.admit(false)).isInstanceOf(ApiFailure.class);
+            assertThat(TimeUnit.NANOSECONDS.toMillis(System.nanoTime() - started)).isGreaterThanOrEqualTo(10);
+        }
+        try (var permit = gate.admit(false)) { assertThat(permit).isNotNull(); }
+        assertThatThrownBy(() -> new AuthAdmission(1, 1, 1, 1, System::nanoTime, 0, 1))
+                .isInstanceOf(IllegalArgumentException.class);
+    }
