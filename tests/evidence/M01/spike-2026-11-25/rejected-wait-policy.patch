+    @Test
+    void boundedIdentityWaitRecoversWhenProcessingSlotIsReleased() throws Exception {
+        var gate = new AuthAdmission(1, 1, 100, 100, System::nanoTime, 1, 2000);
+        var occupied = gate.admit(false);
+        var entered = new CountDownLatch(1);
+        try (var pool = Executors.newVirtualThreadPerTaskExecutor()) {
+            var waiter = pool.submit(() -> {
+                entered.countDown();
+                try (var permit = gate.admit(false)) { return true; }
+            });
+            assertThat(entered.await(1, TimeUnit.SECONDS)).isTrue();
+            try {
+                assertThatThrownBy(() -> waiter.get(50, TimeUnit.MILLISECONDS))
+                        .isInstanceOf(java.util.concurrent.TimeoutException.class);
+                // The only waiting place is occupied; another request must fail promptly.
+                assertThatThrownBy(() -> gate.admit(false)).isInstanceOf(ApiFailure.class);
+                // Password work remains isolated while identity work waits.
+                try (var password = gate.admit(true)) { assertThat(password).isNotNull(); }
+            } finally { occupied.close(); }
+            assertThat(waiter.get(1, TimeUnit.SECONDS)).isTrue();
+        }
+        try (var permit = gate.admit(false)) { assertThat(permit).isNotNull(); }
+    }
+
